{
  "name": "prosite-editor",
  "version": "0.1.0",
  "private": true,
  "description": "ProSite Editor for Windows",
"main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.prositesolution.editor",
    "productName": "ProSite Editor",
    "directories": {
      "output": "dist"
    },
   "files": [
  "*.js",
  "*.html",
  "*.css",
  "package.json",
  "node_modules/**/*"
],
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
