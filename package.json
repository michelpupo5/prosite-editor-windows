{
  "name": "prosite-editor",
  "version": "0.3.0",
  "private": true,
  "description": "ProSite Editor Windows with managed local WordPress PHP and SQLite preview (no Docker)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/runtime.js"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.prositesolution.editor",
    "productName": "ProSite Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "runtime-bundle",
        "to": "runtime-bundle",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
